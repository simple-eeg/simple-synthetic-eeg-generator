{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-eeg.example/schema/generator-settings-v3.json",
  "title": "SIMPLE synthetic generator frozen settings",
  "type": "object",
  "additionalProperties": false,
  "description": "Nested values are additionally bound byte-for-byte by the canonical SHA-256 enforced by settings.py.",
  "required": ["schema", "build", "compatibility", "dataset", "provenance", "seed", "signal", "validation"],
  "properties": {
    "schema": {"const": "simple-synthetic-generator-settings-v3"},
    "build": {"type": "object"},
    "dataset": {"type": "object"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simple_input_contract", "tested_simple_commit"],
      "properties": {
        "simple_input_contract": {"const": "simple-synthetic-input-v1"},
        "tested_simple_commit": {"const": "7d31744d46ddba1bf11c686825e3420fb8328d19"}
      }
    },
    "provenance": {"type": "object"},
    "seed": {"type": "object"},
    "signal": {"type": "object"},
    "validation": {"type": "object"}
  }
}
